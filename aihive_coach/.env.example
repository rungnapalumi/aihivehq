# AIHive Coach Configuration
# Copy this file to .env and fill in your values

# AI Provider (Optional - will use Demo Mode if not provided)
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_BASE=https://api.openai.com/v1  # For OpenAI-compatible APIs

# App Settings
APP_ENV=development
DATABASE_PATH=aihive_coach.db
MAX_TOKENS=2000
TEMPERATURE=0.7

# Feature Flags
ENABLE_DEMO_MODE=auto  # auto, true, or false
LOG_API_USAGE=true

# Coach booking calendar sync (Namecheap Private Email CalDAV)
# Official server (Namecheap KB 10820): https://dav.privateemail.com/
# Use an Application Password if it differs from the webmail password.
# Never put this password in frontend code or commit it.
AIHIVE_CALDAV_URL=https://dav.privateemail.com/
AIHIVE_CALDAV_USER=rungnapa@aihivehq.com
AIHIVE_CALDAV_PASSWORD=

# Paid 30-minute sessions (Stripe Checkout, TEST MODE only)
# Use a sk_test_ key. sk_live_ keys are refused unless AIHIVE_PAYMENTS_LIVE=true.
# Never put this key in frontend code or commit it. Do not enable live charges without approval.
# STRIPE_SECRET_KEY=sk_test_your_test_key_here
# AIHIVE_PAYMENTS_LIVE=false
# Price in whole baht. Leave unset to use the labeled placeholder (1500 THB, not a final price).
# AIHIVE_SESSION_PRICE_THB=1500
# Public URL used as the Stripe Checkout return address (Render sets RENDER_EXTERNAL_URL).
# AIHIVE_PUBLIC_URL=https://aihive-coach.onrender.com

